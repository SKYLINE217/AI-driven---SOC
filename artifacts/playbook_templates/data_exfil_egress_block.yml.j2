---
# ============================================================
# Containment Playbook: Data Exfiltration Egress Block (T1041)
# DRAFT ONLY — Requires Approver authorization before execution
# Generated by SOC Triager · Incident: {{ incident_id }}
# ============================================================
- name: "SOC Containment — Data Exfil Egress Block ({{ technique_id }})"
  hosts: firewall
  become: yes
  vars:
    attacker_ip: "{{ attacker_ip }}"
    victim_host: "{{ victim_host }}"
    incident_id: "{{ incident_id }}"
  tasks:
    - name: Block outbound traffic to exfil destination
      iptables:
        chain: OUTPUT
        destination: "{{ attacker_ip }}"
        jump: DROP
        comment: "SOC-AUTO: {{ incident_id }} T1041 exfil-block"

    - name: Block FORWARD to exfil destination
      iptables:
        chain: FORWARD
        destination: "{{ attacker_ip }}"
        jump: DROP
        comment: "SOC-AUTO: {{ incident_id }}"

    - name: Save iptables rules
      command: netfilter-persistent save
      ignore_errors: yes

- name: Capture forensic memory snapshot
  hosts: "{{ victim_host }}"
  become: yes
  tasks:
    - name: Install avml if missing
      apt:
        name: avml
        state: present
      ignore_errors: yes

    - name: Capture memory image
      command: "avml /forensics/{{ incident_id }}_memory.lime"
      async: 300
      poll: 0
      ignore_errors: yes
