# =============================================================================
# SOC Triager — Backend Environment Variables
# Copy to .env and fill in your values
# =============================================================================

# Database
POSTGRES_USER=soc_user
POSTGRES_PASSWORD=soc_postgres_dev
POSTGRES_DB=soc_triager
DATABASE_URL=postgresql://soc_user:soc_postgres_dev@localhost:5432/soc_triager

# Redis
REDIS_PASSWORD=soc_redis_dev
REDIS_URL=redis://:soc_redis_dev@localhost:6379/0

# Redpanda / Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# LLM
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Auth
JWT_SECRET=change_me_generate_with_openssl_rand_base64_32

# Internal service-to-service auth
INTERNAL_SERVICE_TOKEN=change_me_generate_a_random_token

# Grafana
GRAFANA_PASSWORD=soc_grafana_dev
