---
# ============================================================
# Containment Playbook: Lateral Movement Network Segmentation (T1021.x)
# DRAFT ONLY — Requires Approver authorization before execution
# Generated by SOC Triager · Incident: {{ incident_id }}
# ============================================================
- name: "SOC Containment — Lateral Movement Segmentation ({{ technique_id }})"
  hosts: firewall
  become: yes
  vars:
    victim_host: "{{ victim_host }}"
    victim_ip: "{{ victim_ip }}"
    incident_id: "{{ incident_id }}"
  tasks:
    - name: Block SMB traffic from pivot host
      iptables:
        chain: FORWARD
        source: "{{ victim_ip }}"
        protocol: tcp
        destination_port: 445
        jump: DROP
        comment: "SOC-AUTO: {{ incident_id }} lateral-smb-block"

    - name: Block RDP traffic from pivot host
      iptables:
        chain: FORWARD
        source: "{{ victim_ip }}"
        protocol: tcp
        destination_port: 3389
        jump: DROP
        comment: "SOC-AUTO: {{ incident_id }} lateral-rdp-block"

    - name: Block SSH lateral movement from pivot
      iptables:
        chain: FORWARD
        source: "{{ victim_ip }}"
        protocol: tcp
        destination_port: 22
        jump: DROP
        comment: "SOC-AUTO: {{ incident_id }} lateral-ssh-block"

    - name: Save iptables rules
      command: netfilter-persistent save
      ignore_errors: yes

- name: Isolate compromised host network interface
  hosts: "{{ victim_host }}"
  become: yes
  tasks:
    - name: Tag host for quarantine review
      file:
        path: /etc/soc-quarantine-{{ incident_id }}
        state: touch
        mode: "0440"
