---
# ============================================================
# Containment Playbook: Process Injection Host Isolation (T1055.x)
# DRAFT ONLY — Requires Approver authorization before execution
# Generated by SOC Triager · Incident: {{ incident_id }}
# ============================================================
- name: "SOC Containment — Process Injection Host Isolation ({{ technique_id }})"
  hosts: "{{ victim_host }}"
  become: yes
  vars:
    victim_host: "{{ victim_host }}"
    incident_id: "{{ incident_id }}"
    technique_id: "{{ technique_id }}"
  tasks:
    - name: Isolate infected host from internal network (allow SOC management only)
      iptables:
        chain: OUTPUT
        destination: "10.0.0.0/8"
        jump: DROP
        comment: "SOC-ISOLATE: {{ incident_id }} {{ technique_id }}"
      ignore_errors: yes

    - name: Trigger live memory capture
      command: "lime-capture -o /tmp/memdump_{{ incident_id }}.lime"
      ignore_errors: yes

    - name: Suspend suspicious parent/target processes
      command: "pkill -STOP -f powershell.exe"
      ignore_errors: yes

    - name: Record EDR forensic snapshot
      command: "tar -czf /tmp/edr_snapshot_{{ incident_id }}.tar.gz /var/log/syslog /var/log/audit/"
      ignore_errors: yes
