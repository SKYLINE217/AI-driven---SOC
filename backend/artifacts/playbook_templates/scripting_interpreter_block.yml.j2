---
# ============================================================
# Containment Playbook: Command and Scripting Interpreter Block (T1059)
# DRAFT ONLY — Requires Approver authorization before execution
# Generated by SOC Triager · Incident: {{ incident_id }}
# ============================================================
- name: "SOC Containment — Script Interpreter Execution Block ({{ technique_id }})"
  hosts: "{{ victim_host }}"
  become: yes
  vars:
    victim_host: "{{ victim_host }}"
    incident_id: "{{ incident_id }}"
    technique_id: "{{ technique_id }}"
  tasks:
    - name: Terminate suspicious child shell processes
      command: "pkill -KILL -f -e 'cmd.exe|powershell.exe|wscript.exe|cscript.exe'"
      ignore_errors: yes

    - name: Enable PowerShell Constrained Language Mode
      lineinfile:
        path: /etc/environment
        line: "__PSLockdownPolicy=4"
        create: yes
      ignore_errors: yes

    - name: Quarantine downloaded scripts in temp directories
      command: "find /tmp /var/tmp -maxdepth 2 -type f -name '*.ps1' -exec mv {} /opt/soc/quarantine/ \\;"
      ignore_errors: yes

    - name: Notify host administrator of containment
      mail:
        to: secops@internal.corp
        subject: "SOC Containment Applied: T1059 on {{ victim_host }}"
        body: "Incident {{ incident_id }} triggered interpreter containment on {{ victim_host }}."
      ignore_errors: yes
