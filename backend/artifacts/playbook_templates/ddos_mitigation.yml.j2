---
# ============================================================
# Containment Playbook: Network Denial of Service Mitigation (T1498)
# DRAFT ONLY — Requires Approver authorization before execution
# Generated by SOC Triager · Incident: {{ incident_id }}
# ============================================================
- name: "SOC Containment — DDoS Mitigation ({{ technique_id }})"
  hosts: firewall
  become: yes
  vars:
    attacker_ip: "{{ attacker_ip }}"
    incident_id: "{{ incident_id }}"
  tasks:
    - name: Rate limit incoming traffic from attacker
      iptables:
        chain: INPUT
        source: "{{ attacker_ip }}"
        match: limit
        limit: 10/minute
        jump: ACCEPT

    - name: Drop excess traffic from attacker
      iptables:
        chain: INPUT
        source: "{{ attacker_ip }}"
        jump: DROP
        comment: "SOC-AUTO: {{ incident_id }} DDoS-mitigation"

    - name: Enable SYN flood protection
      sysctl:
        name: net.ipv4.tcp_syncookies
        value: "1"
        state: present

    - name: Reduce SYN_RECV timeout
      sysctl:
        name: net.ipv4.tcp_syn_retries
        value: "2"
        state: present

    - name: Save iptables rules
      command: netfilter-persistent save
      ignore_errors: yes
