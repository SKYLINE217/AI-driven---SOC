---
# ============================================================
# Containment Playbook: Privilege Escalation Account Suspend (T1548.x)
# DRAFT ONLY — Requires Approver authorization before execution
# Generated by SOC Triager · Incident: {{ incident_id }}
# ============================================================
- name: "SOC Containment — Privilege Escalation Account Suspend ({{ technique_id }})"
  hosts: "{{ victim_host }}"
  become: yes
  vars:
    victim_user: "{{ victim_user }}"
    victim_host: "{{ victim_host }}"
    incident_id: "{{ incident_id }}"
  tasks:
    - name: Lock the escalated account
      user:
        name: "{{ victim_user }}"
        password_lock: yes
        comment: "SOC-LOCKED: {{ incident_id }}"

    - name: Kill all active sessions for the user
      command: "pkill -KILL -u {{ victim_user }}"
      ignore_errors: yes

    - name: Remove sudo access temporarily
      lineinfile:
        path: /etc/sudoers.d/soc-temp-revoke
        line: "{{ victim_user }} ALL=(ALL) !ALL"
        create: yes
        validate: "visudo -cf %s"

    - name: Record session kill in audit log
      command: >
        auditctl -a always,exit -F arch=b64 -S execve
        -F uid={{ victim_user }} -k soc-{{ incident_id }}
      ignore_errors: yes
