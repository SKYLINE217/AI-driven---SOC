---
# ============================================================
# Containment Playbook: Valid Accounts / Impossible Travel Lockout (T1078)
# DRAFT ONLY — Requires Approver authorization before execution
# Generated by SOC Triager · Incident: {{ incident_id }}
# ============================================================
- name: "SOC Containment — Account Lockout & Session Revocation ({{ technique_id }})"
  hosts: auth-server
  become: yes
  vars:
    victim_user: "{{ victim_user }}"
    attacker_ip: "{{ attacker_ip }}"
    incident_id: "{{ incident_id }}"
    technique_id: "{{ technique_id }}"
  tasks:
    - name: Revoke all active SSO / OAuth refresh tokens
      command: "identity-admin revoke-tokens --user {{ victim_user }}"
      ignore_errors: yes

    - name: Force password reset and MFA re-enrollment
      command: "identity-admin require-mfa-reset --user {{ victim_user }}"
      ignore_errors: yes

    - name: Temporarily block egress/ingress to rogue IP
      iptables:
        chain: INPUT
        source: "{{ attacker_ip }}"
        jump: DROP
        comment: "SOC-IMPOSSIBLE-TRAVEL: {{ incident_id }}"

    - name: Log session termination event in SIEM
      logger:
        msg: "SOC-CONTAINMENT: User {{ victim_user }} session revoked due to impossible travel (Incident {{ incident_id }})"
