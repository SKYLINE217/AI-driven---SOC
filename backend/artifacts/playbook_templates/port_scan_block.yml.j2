---
# ============================================================
# Containment Playbook: Network Service Discovery / Port Scan (T1046)
# DRAFT ONLY — Requires Approver authorization before execution
# Generated by SOC Triager · Incident: {{ incident_id }}
# ============================================================
- name: "SOC Containment — Port Scan Block ({{ technique_id }})"
  hosts: firewall
  become: yes
  vars:
    attacker_ip: "{{ attacker_ip }}"
    incident_id: "{{ incident_id }}"
    technique_id: "{{ technique_id }}"
  tasks:
    - name: Block scanner IP on perimeter firewall
      iptables:
        chain: INPUT
        source: "{{ attacker_ip }}"
        jump: DROP
        comment: "SOC-RECON-BLOCK: {{ incident_id }} {{ technique_id }}"

    - name: Rate-limit SYN packets from scanner subnet
      iptables:
        chain: FORWARD
        source: "{{ attacker_ip }}/24"
        protocol: tcp
        tcp_flags:
          flags: ["SYN"]
          flags_set: ["SYN"]
        limit: "10/minute"
        jump: ACCEPT
      ignore_errors: yes

    - name: Commit firewall rules
      command: netfilter-persistent save
      ignore_errors: yes
