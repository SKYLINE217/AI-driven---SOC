---
# ============================================================
# Containment Playbook: Brute Force (T1110.x)
# DRAFT ONLY — Requires Approver authorization before execution
# Generated by SOC Triager · Incident: {{ incident_id }}
# Technique: {{ technique_id }} · Tactic: {{ tactic }}
# ============================================================
- name: "SOC Containment — Brute Force IP Block ({{ technique_id }})"
  hosts: firewall
  become: yes
  vars:
    attacker_ip: "{{ attacker_ip }}"
    victim_host: "{{ victim_host }}"
    incident_id: "{{ incident_id }}"
  tasks:
    - name: Block attacker IP on INPUT chain
      iptables:
        chain: INPUT
        source: "{{ attacker_ip }}"
        jump: DROP
        comment: "SOC-AUTO: {{ incident_id }} {{ technique_id }}"

    - name: Block attacker IP on FORWARD chain
      iptables:
        chain: FORWARD
        source: "{{ attacker_ip }}"
        jump: DROP
        comment: "SOC-AUTO: {{ incident_id }}"

    - name: Save iptables rules
      command: netfilter-persistent save
      ignore_errors: yes

- name: Force credential rotation on victim host
  hosts: "{{ victim_host }}"
  become: yes
  tasks:
    - name: Lock targeted accounts temporarily
      user:
        name: "{{ victim_user }}"
        password_lock: yes
      ignore_errors: yes
